# Database (PostgreSQL — Neon, Supabase, or Vercel Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/linguacoda?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-random-secret"

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public URL of this API (no trailing slash)
# Local dev: http://localhost:3000
# Production: https://your-api.vercel.app
AUTH_URL="http://localhost:3000"

# Compute gateway JWT (must match home PC gateway JWT_SECRET)
JWT_SECRET="replace-with-random-secret"

# Optional — server-side health ping (not exposed to clients)
COMPUTE_GATEWAY_URL="https://compute.yourdomain.com"
