# Shared secret for compute JWT (must match Vercel JWT_SECRET and gateway)
JWT_SECRET=

# Enable JWT requirement on gateway POST endpoints
LINGUACODA_REMOTE_MODE=1

# Concurrency limits
MAX_CONCURRENT_TRANSCRIPTIONS=2
MAX_CONCURRENT_OLLAMA=1

# Ollama (optional override)
OLLAMA_ENDPOINT=http://127.0.0.1:11434
